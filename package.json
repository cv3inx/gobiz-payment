{
  "name": "gobiz-payment",
  "version": "1.0.0",
  "description": "Self-hosted QRIS payment gateway di atas GoBiz (GoPay Merchant) — QRIS dinamis, matching pembayaran otomatis, webhook bertanda tangan.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "exports": {
    ".": "./server.js",
    "./lib/gobiz.js": "./lib/gobiz.js",
    "./src/security.js": "./src/security.js"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node tests/run.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop gobiz-payment",
    "pm2:restart": "pm2 restart gobiz-payment",
    "pm2:logs": "pm2 logs gobiz-payment"
  },
  "keywords": [
    "gopay",
    "gobiz",
    "gojek",
    "payment",
    "merchant",
    "indonesia"
  ],
  "author": "kavionn (lib/gobiz.js, demo.js), cv3inx (gateway layer)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "crc": "^4.3.2",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "moment-timezone": "^0.5.45",
    "morgan": "^1.11.0",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1"
  }
}
