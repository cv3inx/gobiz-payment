# Dependencies
node_modules/

# Environment & secrets
.env
.env.local
.env.*.local
.claude

# Vercel
.vercel

# Nuxt build output
.nuxt
.output
.nitro

# Knowledge-graph artifacts (graphify)
graphify-out/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# `vercel link` appends `.env*`, which would swallow the committed template too.
.env*
!.env.example
.agents

# package-lock.json is deliberately NOT ignored. This is an application, not a
# library: the lockfile is what pins the exact dependency versions that reach
# production, and both `npm ci` in CI and Vercel's build need it to be reproducible.
