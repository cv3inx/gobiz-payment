# ═══════════════════════════════════════════════════════════════
#  WAJIB DIISI
# ═══════════════════════════════════════════════════════════════

# Postgres. Di Vercel ini otomatis keisi kalau pakai integrasi Neon/Supabase.
# Sertifikat server SELALU diverifikasi (sslmode dipaksa jadi verify-full di kode).
# Kalau server-mu pakai CA privat, tambahkan `ca:` di src/db/index.js — jangan
# matikan verifikasinya.
# WAJIB pakai connection string mode transaction/pooler:
#   Supabase -> port 6543   |   Neon -> host "...-pooler..."
# Serverless bikin banyak instance; koneksi direct bakal habis.
DATABASE_URL="postgres://user:pass@host:6543/dbname?sslmode=require"

# Login GoBiz. Belum punya password? Bikin di portal.gofoodmerchant.co.id
# → Profile → atur password. (Alternatif tanpa password: GOPAY_ACCESS_TOKEN di bawah.)
GOPAY_EMAIL="email@merchant.com"
GOPAY_PASSWORD="password-kamu"

# QRIS statis merchant — scan gambar QRIS dari portal GoBiz, paste hasilnya.
QRIS_STRING="00020101021226..."

# Ke mana notifikasi pembayaran dikirim + kunci tanda tangannya.
# Secret WAJIB diganti (bukan "change-me") kalau NODE_ENV=production.
WEBHOOK_URL="https://app-kamu.com/webhook"
WEBHOOK_SECRET="ganti-ini-random-panjang"

# Proteksi endpoint tulis + login admin dashboard di /admin.
# Kosong = SIAPA AJA bisa bikin transaksi, buka dashboard, DAN memicu polling ke
# GoBiz lewat /api/admin/poll sampai akunmu kena rate-limit. Isi.
API_KEY="ganti-ini-random-panjang"


# ═══════════════════════════════════════════════════════════════
#  OPSIONAL — semua ada default
# ═══════════════════════════════════════════════════════════════

# Domain publik buat qrImageUrl absolut, mis. https://pay.violetics.id
# Kosong = ditebak dari VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_URL=""

# Jumlah hop proxy yang dipercaya untuk X-Forwarded-For.
# 1 = Vercel saja. Naikkan ke 2 kalau di depannya ada Cloudflare mode proxy
# (awan oranye), kalau tidak rate limiter membaca IP Cloudflare bukan IP asli.
TRUST_PROXY=1

PORT=3000
EXPIRE_MINUTES=5      # umur transaksi (menit), bisa dioverride per-trx, maks 10080

# Ganti email/password di atas dengan token dari browser
# (F12 → Application → Cookies → access_token) kalau ga mau nyimpen password.
# Token menang kalau diisi, tapi bisa expired dan harus di-refresh manual.
GOPAY_ACCESS_TOKEN=""
GOPAY_MERCHANT_ID=""


# ═══════════════════════════════════════════════════════════════
#  TUNING — ubah kalau perlu
# ═══════════════════════════════════════════════════════════════
# POLL_MIN_INTERVAL_MS=7000   # jeda minimum antar poll ke GoBiz, berlaku global
#                             # (lintas instance). < 7000 = risiko akun diblokir.
# UNIQUE_CODE_MAX=99          # kode unik berurutan 1..99 lalu wrap; juga batas trx pending per nominal
# RATE_MAX=60                 # max request per IP per menit (per-instance di serverless)
# MAX_AMOUNT=1000000000       # batas atas amount & fee
# WEBHOOK_TIMEOUT_MS=10000    # timeout per attempt kirim webhook
# WEBHOOK_MAX_ATTEMPTS=12     # ~2 jam coverage kalau consumer mati
# WEBHOOK_MAX_BACKOFF_MS=900000
# TZ_NAME=Asia/Jakarta        # zona waktu buat format waktu history GoBiz
